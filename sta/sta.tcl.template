# OpenSTA timing for one netlist (build-plan.md S7.3). Rendered by sta/run_sta.py.
# Pre-layout, no wire parasitics: indicative numbers, not sign-off.
read_liberty {LIB}
set_cmd_units -time ns
read_verilog {NETLIST}
link_design {TOP}

if {[llength [get_ports -quiet clk]] > 0} {
  create_clock -name clk -period {PERIOD_NS} [get_ports clk]
} else {
  # Combinational design (the S3.7a smoke adder): time it against a virtual clock.
  create_clock -name clk -period {PERIOD_NS}
}
set data_inputs {}
foreach port [all_inputs] {
  if {[get_name $port] != "clk"} {
    lappend data_inputs $port
  }
}
set_input_delay  -clock clk 0 $data_inputs
set_output_delay -clock clk 0 [all_outputs]

report_checks -path_delay max -fields {slew cap input nets fanout} -digits 3
report_wns -digits 3
report_tns -digits 3
