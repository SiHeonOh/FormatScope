# Flat synthesis for area (build-plan.md S7.1). Rendered by synth/run_synth.py.
# Fairness rule: only the RTL sources, the top module, ALIGN_W, and the abc -D target change between formats.
read_liberty -lib {LIB}
read_verilog -sv {SOURCES}
{CHPARAM}
hierarchy -check -top {TOP}
synth -top {TOP} -flatten
dfflibmap -liberty {LIB}
abc -liberty {LIB} {DTARGET}
opt_clean
tee -o {OUT}_stat.txt stat -liberty {LIB}
tee -q -o {OUT}_stat.json stat -json -liberty {LIB}
delete t:$scopeinfo
write_verilog -noattr -noexpr -nohex -nodec {OUT}_netlist.v
